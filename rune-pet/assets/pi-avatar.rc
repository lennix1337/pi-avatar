1 ICON "pi-avatar.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS 0x00040004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Pi Avatar"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "ProductName", "Pi Avatar"
            VALUE "ProductVersion", APP_VERSION_TEXT
            VALUE "OriginalFilename", "pi-avatar.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
